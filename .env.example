# Copy to .env (git ignores it) and fill in.

# OAuth client ID from Google Cloud Console > APIs & Services > Credentials > OAuth client ID
# (type: Web application). Add http://localhost:5173 and your deployed URL as Authorized JavaScript origins.
GOOGLE_CLIENT_ID=

# Comma-separated Google emails allowed to sign in. Required in production.
ALLOWED_EMAILS=

# Encrypts saved profiles. Generate with: openssl rand -base64 32
# Keep a private backup: losing it makes saved profiles unreadable.
PROFILE_KEY=

# Claude API key from https://platform.claude.com, used to read plain-language care descriptions.
ANTHROPIC_API_KEY=

# Optional
# PORT=3001
# DATA_DIR=data
# Local testing only: adds a "Sign in as local tester" button. The server refuses to start with it in production.
# DEV_LOGIN_EMAIL=
