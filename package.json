{
  "name": "medical-insurance-hunter",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"tsx watch server/index.ts\" \"vite\"",
    "dev:web": "vite",
    "dev:api": "tsx watch server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "formularies": "node --max-old-space-size=6144 --import tsx scripts/build-formularies.mts",
    "formularies:pdf": "tsx scripts/convert-formulary-pdfs.mts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "express": "^5.3.0",
    "google-auth-library": "^11.3.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.7",
    "typescript": "^7.0.2",
    "unpdf": "2.1.0",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22.13"
  }
}
